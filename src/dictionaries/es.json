  "supportArticles": {
    "getting-started": {
      "title": "Primeros Pasos",
      "subtitle": "Guía rápida para configurar su clínica e invitar a su equipo a OdontoFlow.",
      "sections": [
        { "h": "1. Configuración de Clínica", "p": "Para comenzar, vaya a Configuración > Clínica. Complete la dirección, RUT/NIT y horarios de operación. Estos datos aparecerán en los encabezados de sus certificados." },
        { "h": "2. Invitando al Equipo", "p": "Acceda a la pestaña 'Equipo' y haga clic en 'Nuevo Usuario'. Puede definir el nivel de permiso (Dentista, Recepcionista o Administrador). Se enviará una invitación por correo electrónico." }
      ],
      "nextSlug": "scheduling",
      "nextTitle": "Próximo: Citas"
    },
    "scheduling": {
      "title": "Citas",
      "subtitle": "Cómo organizar la agenda de la clínica y optimizar el tiempo de los dentistas.",
      "sections": [
        { "h": "1. Creando una Cita", "p": "En el Tablero, haga clic en el botón azul 'Nueva Cita'. Seleccione el paciente, dentista, horario y motivo de la visita." },
        { "h": "2. Estado y Confirmación", "p": "Puede cambiar el estado de la cita (Confirmado, En Espera, En Atención) haciendo clic en la tarjeta de la cita. El color de estado se actualiza automáticamente." }
      ],
      "nextSlug": "health-records",
      "nextTitle": "Próximo: Historias Clínicas"
    },
    "health-records": {
      "title": "Historias Clínicas",
      "subtitle": "Registro clínico seguro e interoperabilidad.",
      "sections": [
        { "h": "1. Odontograma Interactivo", "p": "Dentro de la ficha del paciente, haga clic en la pestaña 'Odontograma'. Puede seleccionar dientes y marcar procedimientos (ej. Caries, Empaste, Extracción) usando la paleta de colores." },
        { "h": "2. Sincronización RNDS", "p": "Si su clínica está integrada, cualquier nota clínica firmada digitalmente puede enviarse directamente al Ministerio de Salud haciendo clic en el botón 'Sincronizar RNDS'." }
      ],
      "nextSlug": "billing",
      "nextTitle": "Próximo: Facturación"
    },
    "billing": {
      "title": "Facturación",
      "subtitle": "Gestión de facturación, presupuestos y planes de tratamiento.",
      "sections": [
        { "h": "1. Creando Presupuestos", "p": "En el historial médico, acceda a 'Plan de Tratamiento'. Agregue los procedimientos que deben realizarse. El sistema calculará el valor total según su lista de precios estándar." },
        { "h": "2. Facturación de Seguros", "p": "Para pacientes asegurados, al finalizar el plan, puede exportar el archivo XML en el formato estándar en la pestaña 'Facturación' para enviarlo a la aseguradora." }
      ],
      "nextSlug": "getting-started",
      "nextTitle": "Volver al Inicio"
    }
  },
