  "compliancePage": {
    "title": "Centro de Confianza y Cumplimiento",
    "subtitle": "Seguridad de datos de nivel empresarial y adecuación legal para su clínica.",
    "cards": {
      "lgpd": {
        "title": "LGPD en la Salud",
        "desc": "OdontoFlow cumple íntegramente con la Ley General de Protección de Datos. Los datos confidenciales se almacenan en nubes cifradas (AES-256) con estricto control de acceso."
      },
      "icp": {
        "title": "Certificación ICP-Brasil",
        "desc": "Todos los documentos, certificados médicos e historias clínicas electrónicas soportan firmas digitales a través de certificados ICP-Brasil, asegurando su validez legal plena."
      },
      "rnds": {
        "title": "Interoperabilidad RNDS",
        "desc": "Nuestro sistema se desarrolla en base a las normativas del Ministerio de Salud para la integración nativa con la Red Nacional de Datos de Salud (RNDS)."
      },
      "hipaa": {
        "title": "Estándares Internacionales",
        "desc": "Utilizamos una infraestructura escalable que sigue los estándares de cumplimiento globales, incluidas pautas similares a la HIPAA."
      },
      "cfo": {
        "title": "Resolución CFO-226/2020",
        "desc": "Estricta alineación con el Consejo Federal de Odontología (CFO) respecto a la teleodontología y emisión de certificados digitales."
      },
      "tiss": {
        "title": "Estándar TISS / TUSS",
        "desc": "Soporte completo para el Intercambio de Información de Salud Suplementaria (TISS), asegurando una facturación precisa con los seguros dentales."
      },
      "iso": {
        "title": "Prácticas ISO 27001",
        "desc": "Los procesos de ingeniería de OdontoFlow están inspirados en los requisitos de ISO 27001, el estándar más alto para la Seguridad de la Información."
      },
      "backup": {
        "title": "Retención Legal (SLA 99.9%)",
        "desc": "Políticas de copias de seguridad continuas y retención en cumplimiento con las leyes que exigen el almacenamiento de historiales durante al menos 20 años."
      }
    }
  },
